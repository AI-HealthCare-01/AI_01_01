{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JournalEntry",
  "type": "object",
  "required": [
    "journal_id",
    "user_id",
    "entry_date",
    "body",
    "status"
  ],
  "properties": {
    "journal_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "entry_date": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "preview_text": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "deleted"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}