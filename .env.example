# App
APP_NAME=mindsight
APP_ENV=local
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=
USE_FIREBASE_AUTH_EMULATOR=false

# Ports (docker-up auto picks fallback when omitted)
WEB_PORT=3000
API_PORT=8000
DB_PORT=5432
AUTH_EMULATOR_PORT=9099
AUTH_EMULATOR_UI_PORT=4000

# Database
# Runtime storage (current default): SQLite via AUTH_DATABASE_PATH
# DATABASE_URL is prepared for Postgres migration/deploy path.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mindsight_local
AUTH_DATABASE_PATH=./apps/api/.data/auth_account.db

# Firebase Auth (Web) - required when USE_FIREBASE_AUTH_EMULATOR=false
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_AUTH_LANGUAGE_CODE=ko
NEXT_PUBLIC_AUTH_CONTINUE_BASE_URL=http://localhost:3000

# Production example
# APP_ENV=prod
# APP_URL=https://www.ozcodlngschool.com
# API_BASE_URL=https://api.ozcodlngschool.com
# NEXT_PUBLIC_API_BASE_URL=https://api.ozcodlngschool.com
# NEXT_PUBLIC_AUTH_CONTINUE_BASE_URL=https://www.ozcodlngschool.com

# Firebase Auth Emulator (optional)
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
AUTH_ALLOW_EMULATOR_UID_FALLBACK=true

# Firebase Admin (API)
FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# API runtime
MODEL_BUNDLE_DIR=./model
BOARD_TOXIC_MODEL_ENABLED=false
BOARD_TOXIC_MODEL_NAME=jinkyeongk/kcELECTRA-toxic-detector
BOARD_TOXIC_MODEL_THRESHOLD=0.82
BOARD_TOXIC_MODEL_POSITIVE_LABELS=toxic,hate,abusive,abuse,offensive,insult,obscene,label_1
BOARD_TOXIC_MODEL_NEGATIVE_LABELS=clean,neutral,safe,non-toxic,non_toxic,label_0
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,https://www.ozcodlngschool.com,https://ozcodlngschool.com
ADMIN_OWNER_EMAIL=
ADMIN_OWNER_FIREBASE_UID=

# OpenAI / LLM
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Storage
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AWS
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Logging / Monitoring
LOG_LEVEL=INFO
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=

# Feature Flags
ENABLE_ADMIN_CONSOLE=true
ENABLE_REPORT_EXPORT=true
ENABLE_CBT=true
ENABLE_BOARD=true
