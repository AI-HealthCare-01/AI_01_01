{
  "name": "@mindsight/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "test \"$MINDSIGHT_ROOT_DEV\" = \"1\" || (echo \"[MindSight] Do not run from apps/web. Run from repo root: npm run dev | npm run dev:web:emulator\" && exit 1); next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test ./tests/smoke.test.mjs"
  },
  "dependencies": {
    "@mindsight/domain": "file:../../packages/domain",
    "@mindsight/shared": "file:../../packages/shared",
    "firebase": "11.1.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "next": "^16.1.6",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.1.6",
    "playwright": "^1.58.2",
    "typescript": "5.5.4"
  }
}
